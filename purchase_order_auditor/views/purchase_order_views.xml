<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_auditor" model="ir.ui.view">
        <field name="name">purchase.order.form.auditor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_run_audit"
                        type="object"
                        string="Run Audit"
                        class="oe_highlight"/>
                <field name="audit_state" widget="statusbar" statusbar_visible="not_audited,ok,issue"/>
            </xpath>

            <xpath expr="//sheet//group" position="after">
                <group string="Audit">
                    <group>
                        <field name="audit_last_date" readonly="1"/>
                        <field name="audit_issue_count" readonly="1"/>
                        <field name="audit_purchase_value" readonly="1"/>
                        <field name="audit_stock_value" readonly="1"/>
                    </group>
                    <group>
                        <field name="audit_bill_value" readonly="1"/>
                        <field name="audit_stock_account_value" readonly="1"/>
                    </group>
                    <group colspan="2">
                        <field name="audit_summary" nolabel="1" readonly="1"/>
                    </group>
                    <group colspan="2">
                        <button name="action_open_audit_lines"
                                type="object"
                                string="View Audit Details"
                                class="btn-secondary"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Audit Lines">
                    <field name="audit_line_ids" readonly="1">
                        <list>
                            <field name="check_type"/>
                            <field name="severity"/>
                            <field name="purchase_order_line_id"/>
                            <field name="message"/>
                            <field name="details"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_search_auditor" model="ir.ui.view">
        <field name="name">purchase.order.search.auditor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Audit Issues" name="audit_issues" domain="[('audit_state', '=', 'issue')]"/>
                <filter string="Audit Matched" name="audit_ok" domain="[('audit_state', '=', 'ok')]"/>
                <filter string="Not Audited" name="audit_not_audited" domain="[('audit_state', '=', 'not_audited')]"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_tree_auditor" model="ir.ui.view">
        <field name="name">purchase.order.tree.auditor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="audit_state" optional="show"/>
                <field name="audit_issue_count" optional="show"/>
                <field name="audit_last_date" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_audit_line_tree" model="ir.ui.view">
        <field name="name">purchase.order.audit.line.tree</field>
        <field name="model">purchase.order.audit.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="purchase_order_id"/>
                <field name="purchase_order_line_id"/>
                <field name="check_type"/>
                <field name="severity"/>
                <field name="message"/>
                <field name="details"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_order_audit_line_form" model="ir.ui.view">
        <field name="name">purchase.order.audit.line.form</field>
        <field name="model">purchase.order.audit.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="purchase_order_id"/>
                            <field name="purchase_order_line_id"/>
                            <field name="check_type"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                        <field name="details"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_order_audit_line_search" model="ir.ui.view">
        <field name="name">purchase.order.audit.line.search</field>
        <field name="model">purchase.order.audit.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="purchase_order_id"/>
                <field name="purchase_order_line_id"/>
                <field name="check_type"/>
                <field name="severity"/>
                <filter string="Errors" name="errors" domain="[('severity', '=', 'error')]"/>
                <filter string="Warnings" name="warnings" domain="[('severity', '=', 'warning')]"/>
                <filter string="Group by Check Type" name="group_by_check_type" context="{'group_by': 'check_type'}"/>
                <filter string="Group by PO" name="group_by_po" context="{'group_by': 'purchase_order_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_order_audit_line" model="ir.actions.act_window">
        <field name="name">Purchase Audit Lines</field>
        <field name="res_model">purchase.order.audit.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_order_audit_line_search"/>
    </record>

    <menuitem id="menu_purchase_order_audit_line"
              name="Purchase Audit Lines"
              parent="purchase.menu_purchase_root"
              action="action_purchase_order_audit_line"
              sequence="90"/>
</odoo>